# Rendered by the nginx image's entrypoint: only ${RELAYER_DOMAIN} is substituted.
limit_req_zone $binary_remote_addr zone=relayer:10m rate=30r/m;

# Any other host name: refuse the TLS handshake.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${RELAYER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${RELAYER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${RELAYER_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:tls:1m;

    server_tokens off;
    client_max_body_size 1k;
    client_body_timeout 10s;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location ~ ^/(bind_payee|claim|review|health)$ {
        limit_req zone=relayer burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://relayer:8080;
        # Overwrites anything the client sent; the relayer rate-limits on this.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
