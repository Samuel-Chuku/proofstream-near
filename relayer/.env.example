# Not secrets. The signing key is never here: it's the Compose secret secrets/relayer_key.json.
RELAYER_ACCOUNT_ID=
# The front end's origin, scheme://host with no path. Only this origin gets CORS.
ALLOWED_ORIGIN=
# Subdomain Caddy serves and gets the certificate for (Cloudflare record: DNS only).
RELAYER_DOMAIN=
# Daily cap on NEAR committed (deposits + prepaid gas), in milliNEAR. 2000 = 2 NEAR.
DAILY_CAP_MILLINEAR=
